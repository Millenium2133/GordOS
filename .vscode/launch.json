{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug GordOS (QEMU)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/kernel.elf",
      "miDebuggerPath": "gdb",
      "miDebuggerServerAddress": "localhost:1234",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        { "text": "set architecture i386" }
      ]
    }
  ]
}